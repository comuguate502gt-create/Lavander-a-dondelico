{
  "name": "Lavandería DONDE LICO – Control de pedidos",
  "short_name": "Donde Lico",
  "description": "Control interno de pedidos de lavado y secado.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b3a9e",
  "theme_color": "#0b3a9e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "archivos", "accept": ["text/plain", ".txt", "application/json", ".json"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": { "text/plain": [".txt"], "application/json": [".json"] }
    }
  ]
}
